STRINGTABLE
BEGIN
    IDS_ACT_OPEN            "&Open"
    IDS_ACT_EXPLORE         "E&xplore"
    IDS_ACT_ACTIVE          "Mark Partition as &Active"
    IDS_ACT_LETTER          "&Change Drive Letter and Paths..."
    IDS_ACT_FORMAT          "&Format..."
    IDS_ACT_DELETE_VOLUME   "&Delete Volume..."
    IDS_ACT_DELETE_PARTITION "&Delete Partition..."
    IDS_ACT_NEW             "New &Simple Volume..."
    IDS_ACT_INIT            "&Initialize Disk"
    IDS_ACT_GPT             "Convert to &GPT Disk"
    IDS_ACT_MBR             "Convert to &MBR Disk"
    IDS_ACT_RESCAN          "Rescan &Disks"
    IDS_ACT_PROPERTIES      "P&roperties"
    IDS_ACT_ALL_TASKS       "All T&asks"
    IDS_CONFIRM_TITLE       "Disk Management"
    IDS_CONFIRM_DELETE      "Deleting this volume will erase all data on it. Back up any data you want to keep before deleting. Do you want to continue?"
    IDS_CONFIRM_FORMAT      "Formatting this volume will erase all data on it. Back up any data you want to keep before formatting. Do you want to continue?"
    IDS_CONFIRM_ACTIVE      "Ensure that the partition you are about to make active includes valid system files. Otherwise the disk will not start. Do you want to continue?"
    IDS_CONFIRM_CONVERT     "Converting this disk to %s keeps no data on it, because the disk holds no volumes. Do you want to continue?"
    IDS_CONFIRM_LETTER      "Some programs that rely on drive letters might not run correctly. Do you want to continue?"
    IDS_CONFIRM_FORCE       "The volume is in use by a program. If you continue, the volume is dismounted and the program may lose data. Do you want to continue?"
    IDS_CONFIRM_REMOVE_PATH "Some programs that rely on drive letters might not run correctly. Are you sure you want to remove this drive letter?"
    IDS_ERROR_TITLE         "Disk Management"
    IDS_ERR_GENERIC         "The operation failed.\n\n%s"
    IDS_ERR_FORMAT          "The format failed.%s"
    IDS_ERR_NO_PROVIDER     "The file system is not installed on this computer."
    IDS_ERR_IN_USE          "The volume is in use and cannot be locked."
    IDS_ERR_NOT_EMPTY       "The disk holds partitions. Delete every volume on the disk first."
    IDS_ERR_LAYOUT          "The partition layout does not allow this change."
    IDS_ERR_NO_VOLUME       "The system has not made a volume for the new partition yet. Use Rescan Disks."
    IDS_ERR_NOT_SUPPORTED   "This system does not support the operation."
    IDS_ERR_PROTECTED       "This volume holds the running system, so it cannot be changed here."
    IDS_ERR_FORMAT_CODE     "\n\n%s"
    IDS_FORMAT_DONE         "The format is complete."
    IDS_FORMATTING          "Formatting %s"
    IDS_WORKING             "Please wait..."
    IDS_ERR_CHANGED         "The disk changed since it was read, so nothing was done. Refresh the view and try again."
    IDS_ERR_UNREADABLE      "The partition table of this disk is not one this program can change."
    IDS_ERR_TYPE_NOT_UPDATED "The volume was formatted, but the type of its partition could not be adjusted to the file system."
    IDS_ERR_VERIFY_FAILED   "The disk does not hold the partition table that was written. Refresh the view to see what it holds now."
    IDS_ERR_RESTORE_FAILED  "Writing the partition table failed, and the table that was on the disk could not be written back. The disk may need repair."
    IDS_ERR_PATHS_NOT_RESTORED "The operation failed, and the drive letters or paths it had taken away from the volume could not all be put back. Check them with Change Drive Letter and Paths."
    IDS_PL_FOLDER_TOO_LONG  "The folder path is too long."
    IDS_NV_INFO_FMT         "Free space: %s.   Largest volume: %s."
    IDS_NV_NO_LETTER        "Do not assign a drive letter"
    IDS_NV_NO_FORMAT        "Do not format this volume"
    IDS_NV_SIZE_RANGE       "The size must be a whole number of megabytes from %I64u to %I64u."
    IDS_NV_LABEL_DEFAULT    "New Volume"
    IDS_NV_NOTE_EXTENDED    "The fourth partition of this disk is made as a logical drive in a new extended partition."
    IDS_NV_NOTE_RESERVED    "A reserved partition is created first, as Windows does on a GPT disk."
    IDS_NV_NOTE_LOGICAL     "The volume is created as a logical drive in the extended partition."
    IDS_NV_TITLE            "New Simple Volume - Disk %u"
    IDS_NV_CREATED_NO_VOLUME "The partition was created, but the system has not made its volume yet. Use Rescan Disks, then format it."
    IDS_ID_TEXT_FMT         "Disk %u must be initialized before Disk Management can use it. Choose the partition style."
    IDS_FM_CLUSTER_DEFAULT  "Default"
    IDS_FM_TITLE            "Format %s"
    IDS_FM_VOLUME_FMT       "Volume: %s"
    IDS_CL_TITLE            "Change Drive Letter and Paths for %s"
    IDS_PL_BAD_FOLDER       "Enter the path of an empty folder that ends with a backslash, for example C:\\Mount\\Data\\."
    IDS_PL_NO_LETTER_FREE   "Every drive letter is in use."
    IDS_CL_NOTHING          "(no drive letter or path)"
    IDS_PROP_LABEL_FAILED   "The label could not be changed.\n\n%s"
    IDS_PL_FOLDER_PATH      "Folder"
    IDS_ID_TITLE            "Initialize Disk"
    IDS_PL_NO_REPARSE       "The file system of that folder does not keep mount points. Choose a folder on an NTFS volume that supports them."
END

IDD_INITDISK DIALOGEX 0, 0, 263, 167
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Initialize Disk"
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    LTEXT "You must initialize a disk before Logical Disk Manager can access it.", IDC_ID_TEXT, 5, 9, 252, 8
    LTEXT "Select disks:", -1, 5, 22, 80, 8
    CONTROL "", IDC_ID_LIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 6, 29, 248, 44
    LTEXT "Use the following partition style for the selected disks:", -1, 5, 82, 252, 8
    AUTORADIOBUTTON "MBR (Master Boot Record)", IDC_ID_MBR, 10, 95, 167, 8, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "GPT (GUID Partition Table)", IDC_ID_GPT, 10, 106, 167, 8
    LTEXT "Note: The GPT partition style is not recognized by all previous versions of Windows. It is recommended for disks larger than 2TB, or disks used on Itanium-based computers.", IDC_ID_NOTE, 5, 122, 252, 25
    DEFPUSHBUTTON "OK", IDOK, 149, 149, 49, 14
    PUSHBUTTON "Cancel", IDCANCEL, 205, 149, 49, 14
END

IDD_FORMAT DIALOGEX 0, 0, 209, 124
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Format"
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
