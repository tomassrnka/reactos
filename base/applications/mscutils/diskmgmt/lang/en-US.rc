LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", ID_EXIT
    END
    POPUP "&Action"
    BEGIN
        MENUITEM "&Refresh\tF5", ID_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "P&roperties\tAlt+Enter", ID_PROPERTIES
    END
    POPUP "&View"
    BEGIN
        POPUP "&Top"
        BEGIN
            MENUITEM "&Disk List", ID_TOP_DISKLIST
            MENUITEM "&Volume List", ID_TOP_VOLLIST
            MENUITEM "&Graphical View", ID_TOP_GRAPH
        END
        POPUP "&Bottom"
        BEGIN
            MENUITEM "&Disk List", ID_BOT_DISKLIST
            MENUITEM "&Volume List", ID_BOT_VOLLIST
            MENUITEM "&Graphical View", ID_BOT_GRAPH
            MENUITEM "&Hidden", ID_BOT_HIDDEN
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Disk Management...", ID_ABOUT
    END
END

IDR_POPUP MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "P&roperties", ID_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "&Refresh", ID_REFRESH
    END
END

IDD_VOL_GENERAL DIALOGEX 0, 0, 252, 232
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    ICON "", IDC_VOL_ICON, 10, 10, 21, 20, SS_ICON
    LTEXT "", IDC_VOL_NAME, 46, 14, 196, 12, SS_NOPREFIX
    CONTROL "", -1, "Static", SS_ETCHEDHORZ | WS_GROUP, 8, 38, 236, 1
    LTEXT "Type:", -1, 10, 48, 54, 8
    LTEXT "", IDC_VOL_TYPE, 70, 48, 170, 8, SS_NOPREFIX
    LTEXT "File system:", -1, 10, 62, 56, 8
    LTEXT "", IDC_VOL_FS, 70, 62, 170, 8, SS_NOPREFIX
    CONTROL "", IDC_VOL_USED_COLOR, "Static", SS_OWNERDRAW, 10, 86, 8, 8
    LTEXT "Used space:", IDC_VOL_USED_LABEL, 26, 86, 54, 8
    RTEXT "", IDC_VOL_USED_BYTES, 84, 86, 90, 8, SS_NOPREFIX
    RTEXT "", IDC_VOL_USED_HUMAN, 180, 86, 60, 8, SS_NOPREFIX
    CONTROL "", IDC_VOL_FREE_COLOR, "Static", SS_OWNERDRAW, 10, 102, 8, 8
    LTEXT "Free space:", IDC_VOL_FREE_LABEL, 26, 102, 54, 8
    RTEXT "", IDC_VOL_FREE_BYTES, 84, 102, 90, 8, SS_NOPREFIX
    RTEXT "", IDC_VOL_FREE_HUMAN, 180, 102, 60, 8, SS_NOPREFIX
    CONTROL "", -1, "Static", SS_ETCHEDHORZ | WS_GROUP, 8, 118, 236, 1
    LTEXT "Capacity:", -1, 26, 128, 54, 8
    RTEXT "", IDC_VOL_CAP_BYTES, 84, 128, 90, 8, SS_NOPREFIX
    RTEXT "", IDC_VOL_CAP_HUMAN, 180, 128, 60, 8, SS_NOPREFIX
    CONTROL "", IDC_VOL_PIE, "Static", SS_OWNERDRAW, 70, 152, 112, 56
    CTEXT "", IDC_VOL_DRIVE, 10, 214, 232, 8, SS_NOPREFIX
    LTEXT "", IDC_VOL_NOTE, 10, 86, 232, 26
END

IDD_VOL_PARTITION DIALOGEX 0, 0, 252, 232
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Partition"
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    CONTROL "", IDC_PROP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
            6, 6, 240, 218
END

IDD_DISK_GENERAL DIALOGEX 0, 0, 252, 232
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    ICON "", IDC_DISK_ICON, 10, 10, 21, 20, SS_ICON
    LTEXT "", IDC_DISK_NAME, 46, 14, 196, 12, SS_NOPREFIX
    CONTROL "", -1, "Static", SS_ETCHEDHORZ | WS_GROUP, 8, 38, 236, 1
    LTEXT "Device type:", -1, 10, 50, 60, 8
    LTEXT "", IDC_DISK_DEVTYPE, 80, 50, 160, 8, SS_NOPREFIX
    LTEXT "Location:", -1, 10, 66, 60, 8
    LTEXT "", IDC_DISK_LOCATION, 80, 66, 160, 8, SS_NOPREFIX
    GROUPBOX "Disk status", -1, 10, 92, 232, 60
    LTEXT "", IDC_DISK_STATUS, 18, 106, 216, 40, SS_NOPREFIX
END

IDD_DISK_VOLUMES DIALOGEX 0, 0, 252, 232
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Volumes"
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    LTEXT "The volumes contained on this disk are listed below.", -1, 10, 10, 232, 10
    CONTROL "", -1, "Static", SS_ETCHEDHORZ | WS_GROUP, 8, 24, 236, 1
    LTEXT "Disk:", -1, 10, 34, 70, 8
    LTEXT "", IDC_DV_DISK, 90, 34, 150, 8, SS_NOPREFIX
    LTEXT "Type:", -1, 10, 48, 70, 8
    LTEXT "", IDC_DV_TYPE, 90, 48, 150, 8, SS_NOPREFIX
    LTEXT "Status:", -1, 10, 62, 70, 8
    LTEXT "", IDC_DV_STATUS, 90, 62, 150, 8, SS_NOPREFIX
    LTEXT "Partition style:", -1, 10, 76, 70, 8
    LTEXT "", IDC_DV_STYLE, 90, 76, 150, 8, SS_NOPREFIX
    LTEXT "Capacity:", -1, 10, 90, 70, 8
    LTEXT "", IDC_DV_CAPACITY, 90, 90, 150, 8, SS_NOPREFIX
    LTEXT "Unallocated space:", -1, 10, 104, 70, 8
    LTEXT "", IDC_DV_UNALLOC, 90, 104, 150, 8, SS_NOPREFIX
    LTEXT "Reserved space:", -1, 10, 118, 70, 8
    LTEXT "", IDC_DV_RESERVED, 90, 118, 150, 8, SS_NOPREFIX
    LTEXT "Volumes:", -1, 10, 138, 70, 8
    CONTROL "", IDC_DV_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
            10, 150, 232, 56
    PUSHBUTTON "&Properties", IDC_DV_PROPERTIES, 188, 212, 54, 14
END

