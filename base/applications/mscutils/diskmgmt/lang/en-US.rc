    EDITTEXT IDC_VOL_NAME, 46, 12, 196, 12, ES_AUTOHSCROLL
    CONTROL "", -1, "Static", SS_ETCHEDHORZ | WS_GROUP, 8, 38, 236, 1
    LTEXT "Type:", -1, 10, 48, 54, 8
    LTEXT "", IDC_VOL_TYPE, 70, 48, 170, 8, SS_NOPREFIX
    LTEXT "File system:", -1, 10, 62, 56, 8
    LTEXT "", IDC_VOL_FS, 70, 62, 170, 8, SS_NOPREFIX
    CONTROL "", IDC_VOL_USED_COLOR, "Static", SS_OWNERDRAW, 10, 86, 8, 8
    LTEXT "Used space:", IDC_VOL_USED_LABEL, 26, 86, 54, 8
    RTEXT "", IDC_VOL_USED_BYTES, 84, 86, 90, 8, SS_NOPREFIX
    RTEXT "", IDC_VOL_USED_HUMAN, 180, 86, 60, 8, SS_NOPREFIX
    CONTROL "", IDC_VOL_FREE_COLOR, "Static", SS_OWNERDRAW, 10, 102, 8, 8
