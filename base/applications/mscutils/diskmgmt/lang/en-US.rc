    EDITTEXT IDC_FM_LABEL, 86, 6, 117, 13, ES_AUTOHSCROLL
    LTEXT "&File system:", -1, 5, 26, 77, 8
    COMBOBOX IDC_FM_FS, 87, 23, 116, 74, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Allocation unit size:", -1, 5, 43, 77, 8
    COMBOBOX IDC_FM_CLUSTER, 87, 41, 116, 74, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Perform a &quick format", IDC_FM_QUICK, 7, 70, 167, 8
    AUTOCHECKBOX "&Enable file and folder compression", IDC_FM_COMPRESS, 7, 83, 187, 8
    DEFPUSHBUTTON "OK", IDOK, 99, 102, 47, 14
    PUSHBUTTON "Cancel", IDCANCEL, 153, 102, 50, 14
END

