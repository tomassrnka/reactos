END

IDD_EXW_WELCOME DIALOGEX 0, 0, 317, 203
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION ""
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    LTEXT "Welcome to the Extend Volume Wizard", IDC_EXW_TITLE, 113, 9, 193, 30
    LTEXT "This wizard helps you increase the size of simple and spanned volumes. You can extend a volume  by adding space from one or more additional disks.", -1, 113, 40, 193, 27
    LTEXT "To continue, click Next.", -1, 113, 78, 193, 8
END

IDD_EXW_DISKS DIALOGEX 0, 0, 314, 153
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION ""
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    LTEXT "&Available:", -1, 20, 26, 67, 8
    LISTBOX IDC_EX_AVAIL, 20, 36, 95, 58, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "A&dd >", IDC_EX_ADD, 125, 39, 63, 13
    PUSHBUTTON "< &Remove", IDC_EX_REMOVE, 125, 57, 63, 13
    PUSHBUTTON "< Re&move All", IDC_EX_REMOVEALL, 125, 74, 63, 13
    LTEXT "&Selected:", -1, 199, 26, 67, 8
    LISTBOX IDC_EX_SELECTED, 199, 36, 95, 58, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT "Total volume size in megabytes (MB):", -1, 19, 106, 173, 8
    EDITTEXT IDC_EX_TOTAL, 199, 105, 51, 11, ES_READONLY | NOT WS_TABSTOP
    LTEXT "Maximum available space in MB:", -1, 19, 121, 173, 8
    EDITTEXT IDC_EX_MAX, 199, 119, 51, 11, ES_READONLY | NOT WS_TABSTOP
    LTEXT "Select the amount of space in &MB:", -1, 19, 134, 173, 8
    EDITTEXT IDC_EX_AMOUNT, 199, 132, 51, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL "", IDC_EX_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 241, 132, 9, 14
END

IDD_EXW_FINISH DIALOGEX 0, 0, 317, 203
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION ""
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    LTEXT "Completing the Extend Volume Wizard", IDC_EXW_FTITLE, 113, 9, 193, 30
    LTEXT "You selected the following settings:", -1, 113, 42, 193, 8
    LISTBOX IDC_EX_SUMMARY, 113, 54, 188, 57, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT "To close this wizard, click Finish.", -1, 113, 122, 193, 8
END

