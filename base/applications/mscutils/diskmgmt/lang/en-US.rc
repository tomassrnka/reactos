IDD_SHRINK DIALOGEX 0, 0, 297, 167
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shrink"
FONT 8, "MS Shell Dlg", 0, 0
BEGIN
    LTEXT "Total size before shrink in MB:", -1, 7, 13, 190, 8
    EDITTEXT IDC_SH_BEFORE, 201, 9, 90, 13, ES_READONLY | NOT WS_TABSTOP
    LTEXT "Size of available shrink space in MB:", -1, 7, 31, 190, 8
    EDITTEXT IDC_SH_AVAIL, 201, 28, 90, 13, ES_READONLY | NOT WS_TABSTOP
    LTEXT "Enter the amount of space to &shrink in MB:", -1, 7, 49, 190, 8
    EDITTEXT IDC_SH_AMOUNT, 201, 46, 90, 13, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL "", IDC_SH_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 280, 46, 11, 13
    LTEXT "Total size after shrink in MB:", -1, 7, 67, 190, 8
    EDITTEXT IDC_SH_AFTER, 201, 65, 90, 13, ES_READONLY | NOT WS_TABSTOP
    CONTROL "", IDC_SH_ICON, "Static", SS_ICON, 9, 83, 21, 20
    LTEXT "You cannot shrink a volume beyond the point where any unmovable files are located. See the ""defrag"" event in the Application log for detailed information about the operation when it has completed.", IDC_SH_NOTE, 22, 82, 269, 30
    LTEXT "See Shrink a Basic Volume in Disk Management help for more information.", -1, 22, 121, 269, 8
    DEFPUSHBUTTON "&Shrink", IDOK, 179, 149, 49, 13
    PUSHBUTTON "Cancel", IDCANCEL, 242, 149, 49, 13
END

