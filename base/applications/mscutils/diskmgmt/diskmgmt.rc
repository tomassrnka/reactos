#include <windef.h>
#include <winuser.h>
#include <commctrl.h>
#include <prsht.h>

#include "resource.h"

#define REACTOS_STR_FILE_DESCRIPTION  "Disk Management"
#define REACTOS_STR_INTERNAL_NAME     "diskmgmt"
#define REACTOS_STR_ORIGINAL_FILENAME "diskmgmt.exe"
#include <reactos/version.rc>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "res/diskmgmt.exe.manifest"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_DISKMGMT ICON "res/diskmgmt.ico"

/* toolbar images */
IDB_PROP BITMAP "res/properties.bmp"
IDB_REFRESH BITMAP "res/refresh.bmp"

IDR_ACCEL ACCELERATORS
BEGIN
    VK_F5, ID_REFRESH, VIRTKEY
    VK_RETURN, ID_PROPERTIES, VIRTKEY, ALT
END

/* UTF-8 */
#pragma code_page(65001)

/* English is always built in, so that a single-language build still has every string. */
#include "lang/en-US.rc"
