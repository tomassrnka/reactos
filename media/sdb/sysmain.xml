        <!-- Applications -->

        <!-- Globulation 2 -->
        <EXE NAME="glob2.exe" APP_NAME="Globulation 2" VENDOR="Globulation 2 authors">
            <MATCHING_FILE NAME="*">
                <SIZE>0x471e00</SIZE>
                <CHECKSUM>0x89bf7c2a</CHECKSUM>
                <MODULE_TYPE>0x3</MODULE_TYPE>
                <PE_CHECKSUM>0x4793cf</PE_CHECKSUM>
                <LINKER_VERSION>0x10000</LINKER_VERSION>
                <LINK_DATE>0x4a9b2979</LINK_DATE>
            </MATCHING_FILE>
            <SHIM_REF NAME="IgnoreFreeLibrary" COMMAND_LINE="libpng12.dll" />
        </EXE>

        <!-- X64 MSYS2 (CORE-20159) -->
        <EXE NAME="*" APP_NAME="MSYS2 Applications" RUNTIME_PLATFORM="AMD64">
            <MATCHING_FILE NAME="msys-2.0.dll">
                <MODULE_TYPE>0x3</MODULE_TYPE>
            </MATCHING_FILE>
            <SHIM_REF NAME="MsysDecoy" />
        </EXE>

        <!--
            Programs that refuse to run on the Windows version the system reports (NT 5.2). Each one gets the
            lowest layer that was measured to pass its check, or the minimum the project documents when the
            program cannot be run here for other reasons (marked "documented").
        -->

        <!-- Node.js 16 to 21 exits with 216 below Windows 8 (measured with 16.20.2: WIN7RTM is not enough, WIN8RTM starts it) -->
        <EXE NAME="node.exe" APP_NAME="Node.js 16 to 21" VENDOR="Node.js">
            <MATCHING_FILE NAME="*">
                <COMPANY_NAME>Node.js</COMPANY_NAME>
                <PRODUCT_NAME>Node.js</PRODUCT_NAME>
                <ORIGINAL_FILENAME>node.exe</ORIGINAL_FILENAME>
                <BIN_PRODUCT_VERSION>16.0.0.0</BIN_PRODUCT_VERSION>
                <UPTO_BIN_PRODUCT_VERSION>21.65535.65535.65535</UPTO_BIN_PRODUCT_VERSION>
            </MATCHING_FILE>
            <LAYER NAME="WIN8RTM" />
        </EXE>

        <!-- Python 3.9 to 3.12 installers (a Burn bundle; the name carries the version): "Windows Server 2012 or later is required"
             (measured with 3.9.13 and 3.11.9: WIN7RTM still refuses, WIN8RTM passes) -->
        <EXE NAME="*" APP_NAME="Python 3.9 to 3.12 installer" VENDOR="Python Software Foundation">
            <MATCHING_FILE NAME="*">
                <COMPANY_NAME>Python Software Foundation</COMPANY_NAME>
                <INTERNAL_NAME>setup</INTERNAL_NAME>
                <BIN_FILE_VERSION>3.9.0.0</BIN_FILE_VERSION>
                <UPTO_BIN_FILE_VERSION>3.12.65535.65535</UPTO_BIN_FILE_VERSION>
            </MATCHING_FILE>
            <LAYER NAME="WIN8RTM" />
        </EXE>

        <!-- python.exe and pythonw.exe 3.9 to 3.12, the lowest Windows these versions support (documented; the interpreter does not run here yet) -->
        <EXE NAME="python.exe" APP_NAME="Python 3.9 to 3.12" VENDOR="Python Software Foundation">
            <MATCHING_FILE NAME="*">
                <COMPANY_NAME>Python Software Foundation</COMPANY_NAME>
                <PRODUCT_NAME>Python</PRODUCT_NAME>
                <ORIGINAL_FILENAME>python.exe</ORIGINAL_FILENAME>
                <BIN_PRODUCT_VERSION>3.9.0.0</BIN_PRODUCT_VERSION>
                <UPTO_BIN_PRODUCT_VERSION>3.12.65535.65535</UPTO_BIN_PRODUCT_VERSION>
            </MATCHING_FILE>
            <LAYER NAME="WIN8RTM" />
        </EXE>
        <EXE NAME="pythonw.exe" APP_NAME="Python 3.9 to 3.12 (windowed)" VENDOR="Python Software Foundation">
            <MATCHING_FILE NAME="*">
                <COMPANY_NAME>Python Software Foundation</COMPANY_NAME>
                <PRODUCT_NAME>Python</PRODUCT_NAME>
                <ORIGINAL_FILENAME>pythonw.exe</ORIGINAL_FILENAME>
                <BIN_PRODUCT_VERSION>3.9.0.0</BIN_PRODUCT_VERSION>
                <UPTO_BIN_PRODUCT_VERSION>3.12.65535.65535</UPTO_BIN_PRODUCT_VERSION>
            </MATCHING_FILE>
            <LAYER NAME="WIN8RTM" />
        </EXE>

        <!-- LibreOffice 24.8 and later need Windows 10 (documented; the installer is an MSI, see the layers on msiexec.exe) -->
        <EXE NAME="soffice.exe" APP_NAME="LibreOffice 24.8 and later" VENDOR="The Document Foundation">
            <MATCHING_FILE NAME="*">
                <COMPANY_NAME>The Document Foundation</COMPANY_NAME>
                <PRODUCT_NAME>LibreOffice</PRODUCT_NAME>
                <ORIGINAL_FILENAME>soffice.exe</ORIGINAL_FILENAME>
                <BIN_PRODUCT_VERSION>24.8.0.0</BIN_PRODUCT_VERSION>
                <UPTO_BIN_PRODUCT_VERSION>65535.65535.65535.65535</UPTO_BIN_PRODUCT_VERSION>
            </MATCHING_FILE>
            <LAYER NAME="WIN10RTM" />
        </EXE>

        <!-- Programs built with Qt 6 (Qt6Core.dll next to them): Qt 6 supports Windows 10 and later (documented) -->
        <EXE NAME="*" APP_NAME="Qt 6 applications" VENDOR="The Qt Company">
            <MATCHING_FILE NAME="Qt6Core.dll">
                <COMPANY_NAME>The Qt Company Ltd.</COMPANY_NAME>
                <PRODUCT_NAME>Qt6</PRODUCT_NAME>
                <ORIGINAL_FILENAME>Qt6Core.dll</ORIGINAL_FILENAME>
            </MATCHING_FILE>
            <LAYER NAME="WIN10RTM" />
        </EXE>

        <!-- Sysinternals DebugView 5.x (the GUI and the console program, 32 and 64 bit) stops at start with "requires Windows 10
             version 1809 (build 17763)" below that. WIN10RTM reports 10.0 build 18362, which is above the limit (measured with 5.02) -->
        <EXE NAME="*" APP_NAME="Sysinternals DebugView 5 and later" VENDOR="Sysinternals">
            <MATCHING_FILE NAME="*">
                <COMPANY_NAME>Sysinternals</COMPANY_NAME>
                <PRODUCT_NAME>Sysinternals Debugview</PRODUCT_NAME>
                <BIN_PRODUCT_VERSION>5.0.0.0</BIN_PRODUCT_VERSION>
                <UPTO_BIN_PRODUCT_VERSION>65535.65535.65535.65535</UPTO_BIN_PRODUCT_VERSION>
            </MATCHING_FILE>
            <LAYER NAME="WIN10RTM" />
        </EXE>

        <!-- ReactOS shim used to test the shim engine -->
        <EXE NAME="shimtest_ros.exe" APP_NAME="Shim test application" VENDOR="ReactOS">
            <MATCHING_FILE NAME="*">
                <FILE_DESCRIPTION>ReactOS Shim Engine test utility</FILE_DESCRIPTION>
                <ORIGINAL_FILENAME>shimtest_ros.exe</ORIGINAL_FILENAME>
                <INTERNAL_NAME>shimtest_ros</INTERNAL_NAME>
                <COMPANY_NAME>ReactOS - test</COMPANY_NAME>
            </MATCHING_FILE>
            <SHIM_REF NAME="ShimTest" />
        </EXE>
    </DATABASE>
</SDB>
