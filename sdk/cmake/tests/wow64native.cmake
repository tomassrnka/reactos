# Configure a minimal consumer of the real target declarations with deliberately
# unsupported table input. A default native build must remain independent of it.
cmake_minimum_required(VERSION 3.17)
if(NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Set TEST_DIR to a scratch directory")
endif()
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
file(MAKE_DIRECTORY "${TEST_DIR}/src/sdk/cmake" "${TEST_DIR}/src/ntoskrnl/include"
    "${TEST_DIR}/src/win32ss")
configure_file("${source}/sdk/cmake/wow64syscalls.cmake"
    "${TEST_DIR}/src/sdk/cmake/wow64syscalls.cmake" COPYONLY)
file(WRITE "${TEST_DIR}/src/ntoskrnl/include/sysfuncs.h" "#ifdef UNKNOWN\nSVC_(Example, 1)\n#endif\n")
foreach(arch 32 64)
    file(WRITE "${TEST_DIR}/src/win32ss/w32ksvc${arch}.h" "SVC_(Example, 1)\n")
endforeach()
file(WRITE "${TEST_DIR}/src/CMakeLists.txt" "cmake_minimum_required(VERSION 3.17)
project(NativeDefault NONE)
function(add_subdirectory)
endfunction()
function(add_idl_headers)
endfunction()
function(add_dependencies)
endfunction()
set(REACTOS_SOURCE_DIR \"${TEST_DIR}/src\")
include(\"${source}/sdk/include/reactos/CMakeLists.txt\")
")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_DIR}/src" -B "${TEST_DIR}/build"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Fixture configure failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_DIR}/build" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Native default build depends on WoW64 table grammar")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_DIR}/build" --target wow64_syscall_tables
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0)
    message(FATAL_ERROR "Explicit table generation should reject the unsupported input")
endif()
message(STATUS "Native default build is independent of WoW64 table generation")
