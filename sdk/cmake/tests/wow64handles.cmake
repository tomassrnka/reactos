cmake_minimum_required(VERSION 3.17)
include("${CMAKE_CURRENT_LIST_DIR}/../wow64handles.cmake")

set(expected_sign HWND HMENU HICON HCURSOR HHOOK HACCEL HMONITOR HIMC
    HWINEVENTHOOK HDWP HANDLE HDESK HWINSTA HKL LPARAM LRESULT)
set(expected_zero HDC HBRUSH HPEN HFONT HBITMAP HRGN HPALETTE HGDIOBJ
    HCOLORSPACE HINSTANCE HMODULE HGLOBAL HLOCAL WPARAM)
set(seen)
foreach(row IN LISTS WOW64_HANDLE_RULES WOW64_MESSAGE_INTEGER_RULES)
    if(NOT row MATCHES "^([A-Z]+)\\|(USER|NT|GDI|LAYOUT|ADDRESS|INTEGER)\\|(SIGN|ZERO)\\|TRUNCATE$")
        message(FATAL_ERROR "Malformed handle rule: ${row}")
    endif()
    set(type "${CMAKE_MATCH_1}")
    set(extension "${CMAKE_MATCH_3}")
    if(type IN_LIST seen)
        message(FATAL_ERROR "Duplicate handle rule: ${type}")
    endif()
    list(APPEND seen "${type}")
    if(type IN_LIST expected_sign)
        set(want SIGN)
    elseif(type IN_LIST expected_zero)
        set(want ZERO)
    else()
        message(FATAL_ERROR "Unreviewed handle type: ${type}")
    endif()
    if(NOT extension STREQUAL want)
        message(FATAL_ERROR "${type}: expected ${want}, got ${extension}")
    endif()
    # Exercise the consumer expressions at bit 31, -1/-2 and the 32-bit limits.
    foreach(value 0 1 2147483647 2147483648 4294967294 4294967295)
        set(widened "${value}")
        if(extension STREQUAL "SIGN" AND value GREATER_EQUAL 2147483648)
            math(EXPR widened "${value} - 4294967296")
        endif()
        math(EXPR narrowed "${widened} & 0xffffffff")
        if(NOT narrowed EQUAL value)
            message(FATAL_ERROR "${type}: failed round trip of ${value}")
        endif()
    endforeach()
endforeach()
foreach(type IN LISTS expected_sign expected_zero)
    if(NOT type IN_LIST seen)
        message(FATAL_ERROR "Missing handle rule: ${type}")
    endif()
endforeach()
message(STATUS "WoW64 per-type handle rules passed")
