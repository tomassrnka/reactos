# Generate name-based syscall metadata, without a target compiler or Python.
# The NT kernel includes both blocks of sysfuncs.h, regardless of DLL version.
# Keep the accepted input grammar deliberately narrow: a new conditional must
# be understood here before it can silently change syscall numbering.
#
# With PROTOTYPES (the output of wow64protos) the script also describes every
# argument of every call and checks each table's slot count against its prototype.

cmake_minimum_required(VERSION 3.17)

# Flags of a mapping row (the last column of the generated rows):
#   1  no target service
#   2  argument slot counts differ
#   4  the row depends on a table conditional (DBG or _WIN64) on either side
#   8  a prototype argument is a structure or 64-bit value passed by value
#  16  with 2: the difference is fully explained by the prototype (both tables match it)
#  32  a table slot count disagrees with the prototype
#  64  no usable prototype: missing, ambiguous or an argument of unknown type
set(WOW64_MISSING 1)
set(WOW64_COUNTS 2)
set(WOW64_CONDITIONAL 4)
set(WOW64_BYVALUE 8)
set(WOW64_EXPLAINED 16)
set(WOW64_TABLE_WRONG 32)
set(WOW64_NO_PROTOTYPE 64)

function(wow64_read_services path prefix nt win64)
    file(STRINGS "${path}" lines ENCODING UTF-8)
    set(names)
    set(counts)
    set(conds)
    set(cond_names)
    set(cond_values)
    set(block "")
    set(block_cond "-")
    set(skip FALSE)
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "//.*$" "" line "${line}")
        string(REGEX REPLACE "/\\*[^*]*\\*/" "" line "${line}")
        string(STRIP "${line}" line)
        if(line STREQUAL "")
            continue()
        elseif(nt AND line MATCHES "^#ifndef SYSFUNCS_NT[56]_ONLY$")
            if(NOT block STREQUAL "")
                message(FATAL_ERROR "${path}: nested conditional")
            endif()
            set(block "${line}")
            continue()
        elseif(NOT nt AND (line STREQUAL "#ifdef _WIN64" OR line STREQUAL "#if DBG"))
            if(NOT block STREQUAL "")
                message(FATAL_ERROR "${path}: nested conditional")
            endif()
            set(block "${line}")
            if(line STREQUAL "#ifdef _WIN64")
                set(block_cond "_WIN64")
            else()
                set(block_cond "DBG")
            endif()
            if((line STREQUAL "#ifdef _WIN64" AND NOT win64) OR
               (line STREQUAL "#if DBG" AND NOT DBG))
                set(skip TRUE)
            endif()
            continue()
        elseif(line STREQUAL "#endif" AND NOT block STREQUAL "")
            set(block "")
            set(block_cond "-")
            set(skip FALSE)
            continue()
        elseif(NOT line MATCHES "^SVC_\\([ \t]*([A-Za-z_][A-Za-z_0-9]*)[ \t]*,[ \t]*([0-9]+)[ \t]*\\)$")
            message(FATAL_ERROR "${path}: unsupported input: ${line}")
        endif()
        set(name "${CMAKE_MATCH_1}")
        set(argc "${CMAKE_MATCH_2}")
        if(NOT block_cond STREQUAL "-")
            list(APPEND cond_names "${name}")
            list(APPEND cond_values "${block_cond}")
        endif()
        if(skip)
            continue()
        endif()
        if(name IN_LIST names)
            message(FATAL_ERROR "${path}: duplicate service ${name}")
        endif()
        if(argc GREATER 31)
            message(FATAL_ERROR "${path}: argument count out of range for ${name}: ${argc}")
        endif()
        list(APPEND names "${name}")
        list(APPEND counts "${argc}")
        list(APPEND conds "${block_cond}")
    endforeach()
    if(NOT block STREQUAL "" OR NOT names)
        message(FATAL_ERROR "${path}: unterminated conditional or empty service list")
    endif()
    list(LENGTH names count)
    if(count GREATER 4096)
        message(FATAL_ERROR "${path}: service index exceeds the 12-bit table index")
    endif()
    set(${prefix}_names "${names}" PARENT_SCOPE)
    set(${prefix}_counts "${counts}" PARENT_SCOPE)
    set(${prefix}_conds "${conds}" PARENT_SCOPE)
    set(${prefix}_cond_names "${cond_names}" PARENT_SCOPE)
    set(${prefix}_cond_values "${cond_values}" PARENT_SCOPE)
endfunction()

# Read the rows of wow64protos. For every call it defines, in the caller's scope:
#   proto_<call>_state    ok | missing | ambiguous | unresolved
#   proto_<call>_where    header:line, or the reason a prototype is missing
#   proto_<call>_slots32 / _slots64, _byvalue, _args   (state ok, ambiguous and unresolved)
#   proto_<call>_rows     one "index|name|type|kind|size32|size64|slots32|slots64|abi64" per argument
function(wow64_read_prototypes path)
    file(READ "${path}" contents)
    string(REPLACE ";" "," contents "${contents}")
    string(REPLACE "[" "(" contents "${contents}")
    string(REPLACE "]" ")" contents "${contents}")
    string(REPLACE "\n" ";" lines "${contents}")
    set(calls)
    foreach(line IN LISTS lines)
        if(line STREQUAL "")
            continue()
        endif()
        string(REPLACE "," ";" fields "${line}")
        list(GET fields 0 type)
        list(GET fields 1 call)
        if(type STREQUAL "P")
            list(GET fields 2 where)
            list(GET fields 3 argc)
            list(GET fields 4 variants)
            list(GET fields 5 cond)
            list(APPEND calls "${call}")
            set(state_${call} ok)
            if(variants GREATER 1)
                set(state_${call} ambiguous)
            endif()
            set(where_${call} "${where}")
            set(cond_${call} "${cond}")
            set(argc_${call} "${argc}")
            set(slots32_${call} 0)
            set(slots64_${call} 0)
            set(byvalue_${call} 0)
            set(rows_${call})
        elseif(type STREQUAL "M")
            list(GET fields 2 reason)
            list(APPEND calls "${call}")
            set(state_${call} missing)
            set(where_${call} "${reason}")
        elseif(type STREQUAL "A")
            list(GET fields 2 index)
            list(GET fields 3 argname)
            list(GET fields 4 argtype)
            list(GET fields 5 kind)
            list(GET fields 6 size32)
            list(GET fields 7 size64)
            list(GET fields 8 slots32)
            list(GET fields 9 slots64)
            list(GET fields 10 abi64)
            if(kind STREQUAL "unresolved")
                set(state_${call} unresolved)
            else()
                math(EXPR slots32_${call} "${slots32_${call}} + ${slots32}")
                math(EXPR slots64_${call} "${slots64_${call}} + ${slots64}")
            endif()
            if(kind STREQUAL "struct" OR kind STREQUAL "int64" OR kind STREQUAL "float")
                math(EXPR byvalue_${call} "${byvalue_${call}} + 1")
            endif()
            list(APPEND rows_${call} "${index}|${argname}|${argtype}|${kind}|${size32}|${size64}|${slots32}|${slots64}|${abi64}")
        else()
            message(FATAL_ERROR "${path}: unsupported row: ${line}")
        endif()
    endforeach()
    foreach(call IN LISTS calls)
        set(proto_${call}_state "${state_${call}}" PARENT_SCOPE)
        set(proto_${call}_where "${where_${call}}" PARENT_SCOPE)
        if(NOT state_${call} STREQUAL "missing")
            set(proto_${call}_cond "${cond_${call}}" PARENT_SCOPE)
            set(proto_${call}_argc "${argc_${call}}" PARENT_SCOPE)
            set(proto_${call}_slots32 "${slots32_${call}}" PARENT_SCOPE)
            set(proto_${call}_slots64 "${slots64_${call}}" PARENT_SCOPE)
            set(proto_${call}_byvalue "${byvalue_${call}}" PARENT_SCOPE)
            set(proto_${call}_rows "${rows_${call}}" PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# Optional catalogue TSVs: call name in column 1, translation class in column 5.
function(wow64_read_catalog)
    foreach(path IN LISTS CATALOG)
        file(READ "${path}" contents)
        string(REPLACE ";" "," contents "${contents}")
        string(REPLACE "[" "(" contents "${contents}")
        string(REPLACE "]" ")" contents "${contents}")
        string(REPLACE "\n" ";" lines "${contents}")
        foreach(line IN LISTS lines)
            string(REPLACE "\t" ";" fields "${line}")
            list(LENGTH fields count)
            if(count LESS 5)
                continue()
            endif()
            list(GET fields 0 call)
            if(NOT call MATCHES "^Nt[A-Za-z_0-9]+$")
                continue()
            endif()
            list(GET fields 4 class)
            string(REGEX REPLACE "[^A-Za-z0-9+-]" "" class "${class}")
            set(class_${call} "${class}" PARENT_SCOPE)
        endforeach()
    endforeach()
endfunction()

# The slot count a table row must have on its architecture, or -1 when it is not known.
function(wow64_model_slots call arch out)
    set(${out} -1 PARENT_SCOPE)
    if(NOT DEFINED proto_${call}_state)
        return()
    endif()
    if(proto_${call}_state STREQUAL "ok")
        set(${out} "${proto_${call}_slots${arch}}" PARENT_SCOPE)
    endif()
endfunction()

# arch of a table: the NT table counts i386 slots for both architectures
function(wow64_table_arch prefix out)
    if(prefix STREQUAL "w64")
        set(${out} 64 PARENT_SCOPE)
    else()
        set(${out} 32 PARENT_SCOPE)
    endif()
endfunction()

function(wow64_row_flags prefix name count out)
    set(flags 0)
    wow64_table_arch(${prefix} arch)
    wow64_model_slots("Nt${name}" ${arch} model)
    if(DEFINED proto_Nt${name}_state)
        if(proto_Nt${name}_byvalue GREATER 0 AND NOT proto_Nt${name}_state STREQUAL "missing")
            math(EXPR flags "${flags} | ${WOW64_BYVALUE}")
        endif()
        if(NOT proto_Nt${name}_state STREQUAL "ok")
            math(EXPR flags "${flags} | ${WOW64_NO_PROTOTYPE}")
        elseif(NOT model EQUAL count)
            math(EXPR flags "${flags} | ${WOW64_TABLE_WRONG}")
        endif()
    endif()
    set(${out} "${flags}" PARENT_SCOPE)
endfunction()

function(wow64_map_services source target table base)
    set(output "/* Generated by wow64syscalls.cmake. Do not edit.\n"
               " * WOW64_SYSCALL(name, source_id, target_id, source_slots, target_slots, flags)\n"
               " * flags: 1 = target missing, 2 = argument slot count mismatch,\n"
               " *   4 = conditional row (DBG or _WIN64), 8 = structure or 64-bit argument passed by value,\n"
               " *   16 = mismatch explained by the prototype, 32 = a table count disagrees with the prototype,\n"
               " *   64 = no usable prototype.\n"
               " * Missing target ID: 0xffff. IDs include the service table selector.\n"
               " * Matching slots do not imply ABI-compatible arguments or structures. */\n")
    string(JOIN "" output ${output})
    set(report "name,source_id,target_id,source_slots,target_slots,flags\n")
    set(index 0)
    set(problems 0)
    foreach(name IN LISTS ${source}_names)
        list(GET ${source}_counts ${index} source_count)
        list(GET ${source}_conds ${index} source_cond)
        list(FIND ${target}_names "${name}" target_index)
        math(EXPR source_id "${base} + ${index}" OUTPUT_FORMAT HEXADECIMAL)
        set(flags 0)
        wow64_row_flags(${source} "${name}" ${source_count} source_flags)
        if(target_index EQUAL -1)
            set(target_id "0xffff")
            set(target_count 0)
            set(flags ${WOW64_MISSING})
            set(target_cond "-")
            if(name IN_LIST ${target}_cond_names)
                set(target_cond "skipped")
            endif()
            set(target_flags 0)
        else()
            math(EXPR target_id "${base} + ${target_index}" OUTPUT_FORMAT HEXADECIMAL)
            list(GET ${target}_counts ${target_index} target_count)
            list(GET ${target}_conds ${target_index} target_cond)
            wow64_row_flags(${target} "${name}" ${target_count} target_flags)
            if(NOT source_count EQUAL target_count)
                set(flags ${WOW64_COUNTS})
            endif()
        endif()
        if(NOT source_cond STREQUAL "-" OR NOT target_cond STREQUAL "-")
            math(EXPR flags "${flags} | ${WOW64_CONDITIONAL}")
        endif()
        math(EXPR flags "${flags} | ${source_flags} | ${target_flags}")
        # Both tables agree with the prototype and a by-value argument accounts for the difference
        math(EXPR counts_bit "${flags} & ${WOW64_COUNTS}")
        math(EXPR bad_bits "${flags} & (${WOW64_TABLE_WRONG} | ${WOW64_NO_PROTOTYPE})")
        math(EXPR value_bit "${flags} & ${WOW64_BYVALUE}")
        if(counts_bit AND value_bit AND bad_bits EQUAL 0)
            math(EXPR flags "${flags} | ${WOW64_EXPLAINED}")
        endif()
        # Rows only present on one side keep the prototype findings of the side that has them
        math(EXPR reportable "${flags} & ~(${WOW64_BYVALUE} | ${WOW64_EXPLAINED} | ${WOW64_CONDITIONAL})")
        if(reportable)
            math(EXPR problems "${problems} + 1")
        endif()
        if(flags)
            message(STATUS "${table}: Nt${name}: slots ${source_count} -> ${target_count}, flags=${flags}")
        endif()
        string(APPEND output "WOW64_SYSCALL(Nt${name}, ${source_id}, ${target_id}, ${source_count}, ${target_count}, ${flags})\n")
        string(APPEND report "Nt${name},${source_id},${target_id},${source_count},${target_count},${flags}\n")
        math(EXPR index "${index} + 1")
    endforeach()
    set(${table}_output "${output}" PARENT_SCOPE)
    set(${table}_report "${report}" PARENT_SCOPE)
    set(${table}_problems "${problems}" PARENT_SCOPE)
    message(STATUS "${table}: ${index} services, ${problems} flagged mappings")
endfunction()

# Compare every table row with its prototype; every disagreement names the call and the argument types.
function(wow64_check_tables)
    set(wrong)
    foreach(table nt w32 w64)
        wow64_table_arch(${table} arch)
        set(index 0)
        foreach(name IN LISTS ${table}_names)
            list(GET ${table}_counts ${index} count)
            math(EXPR index "${index} + 1")
            wow64_model_slots("Nt${name}" ${arch} model)
            if(model EQUAL -1 OR model EQUAL count)
                continue()
            endif()
            if(arch EQUAL 64)
                set(abi "amd64")
            else()
                set(abi "i386")
            endif()
            set(why "")
            foreach(row IN LISTS proto_Nt${name}_rows)
                string(REPLACE "|" ";" cells "${row}")
                list(GET cells 3 kind)
                if(kind STREQUAL "struct" OR kind STREQUAL "int64" OR kind STREQUAL "float")
                    list(GET cells 1 argname)
                    list(GET cells 2 argtype)
                    list(GET cells 6 slots32)
                    list(GET cells 7 slots64)
                    string(APPEND why " ${argtype} ${argname} is passed by value and takes ${slots32} slots on i386 and ${slots64} on amd64.")
                endif()
            endforeach()
            list(APPEND wrong "Nt${name}: the ${abi} table says ${count} slots, the prototype (${proto_Nt${name}_where}) needs ${model}.${why}")
        endforeach()
    endforeach()
    set(wow64_table_errors "${wrong}" PARENT_SCOPE)
endfunction()

function(wow64_write_calls)
    set(calls_report "call,family,id_i386,id_amd64,slots_i386_table,slots_amd64_table,slots_i386_model,slots_amd64_model,args,byvalue_args,conditional,class,prototype,status\n")
    set(args_report "call,family,index,name,type,kind,size_i386,size_amd64,slots_i386,slots_amd64,abi_amd64,class\n")
    set(args_inc "/* Generated by wow64syscalls.cmake. Do not edit.\n"
                 " * WOW64_ARG(call, index, name, type, kind, size_i386, size_amd64, slots_i386, slots_amd64)\n"
                 " * kind: WOW64_ARG_INT, _INT64, _PTRINT, _HANDLE, _POINTER, _STRUCT, _FLOAT or _UNRESOLVED\n"
                 " * (sizes and slots are 0 for an unresolved type). Structures and 64-bit values are passed by\n"
                 " * value; a structure larger than 8 bytes or of an odd size travels by reference on amd64. */\n")
    string(JOIN "" args_inc ${args_inc})
    set(names)
    set(families)
    foreach(table nt w32 w64)
        if(table STREQUAL "nt")
            set(family "nt")
        else()
            set(family "win32k")
        endif()
        foreach(name IN LISTS ${table}_names)
            if(NOT name IN_LIST names)
                list(APPEND names "${name}")
                list(APPEND families "${family}")
            endif()
        endforeach()
    endforeach()
    set(index 0)
    set(summary_ok 0)
    foreach(name IN LISTS names)
        list(GET families ${index} family)
        math(EXPR index "${index} + 1")
        set(call "Nt${name}")
        # Table position, count and conditional of the call on each side
        set(id32 "-")
        set(id64 "-")
        set(count32 "-")
        set(count64 "-")
        set(cond "-")
        if(family STREQUAL "nt")
            list(FIND nt_names "${name}" position)
            list(GET nt_counts ${position} count32)
            set(count64 "${count32}")
            math(EXPR id32 "${position}" OUTPUT_FORMAT HEXADECIMAL)
            set(id64 "${id32}")
        else()
            list(FIND w32_names "${name}" position)
            if(NOT position EQUAL -1)
                list(GET w32_counts ${position} count32)
                math(EXPR id32 "4096 + ${position}" OUTPUT_FORMAT HEXADECIMAL)
            endif()
            list(FIND w64_names "${name}" position)
            if(NOT position EQUAL -1)
                list(GET w64_counts ${position} count64)
                math(EXPR id64 "4096 + ${position}" OUTPUT_FORMAT HEXADECIMAL)
            endif()
            foreach(side w32 w64)
                list(FIND ${side}_cond_names "${name}" position)
                if(cond STREQUAL "-" AND NOT position EQUAL -1)
                    list(GET ${side}_cond_values ${position} cond)
                endif()
            endforeach()
        endif()
        set(class "-")
        if(DEFINED class_${call})
            set(class "${class_${call}}")
        endif()
        set(model32 "-")
        set(model64 "-")
        set(argc "-")
        set(byvalue "-")
        set(where "-")
        set(status "no-prototype")
        if(DEFINED proto_${call}_state)
            set(where "${proto_${call}_where}")
            if(NOT proto_${call}_state STREQUAL "missing")
                set(argc "${proto_${call}_argc}")
                set(byvalue "${proto_${call}_byvalue}")
                if(proto_${call}_state STREQUAL "ok")
                    set(model32 "${proto_${call}_slots32}")
                    set(model64 "${proto_${call}_slots64}")
                    set(status "ok")
                    if(NOT count32 STREQUAL "-" AND NOT model32 EQUAL count32)
                        set(status "table-mismatch")
                    endif()
                    if(NOT count64 STREQUAL "-" AND family STREQUAL "win32k" AND NOT model64 EQUAL count64)
                        set(status "table-mismatch")
                    endif()
                    if(status STREQUAL "ok" AND byvalue GREATER 0)
                        set(status "by-value")
                    endif()
                else()
                    set(status "${proto_${call}_state}")
                endif()
                foreach(row IN LISTS proto_${call}_rows)
                    string(REPLACE "|" ";" cells "${row}")
                    list(GET cells 0 arg_index)
                    list(GET cells 1 arg_name)
                    list(GET cells 2 arg_type)
                    list(GET cells 3 kind)
                    list(GET cells 4 size32)
                    list(GET cells 5 size64)
                    list(GET cells 6 slots32)
                    list(GET cells 7 slots64)
                    list(GET cells 8 abi64)
                    string(APPEND args_report "${call},${family},${arg_index},${arg_name},${arg_type},${kind},${size32},${size64},${slots32},${slots64},${abi64},${class}\n")
                    string(TOUPPER "${kind}" kind_upper)
                    if(kind STREQUAL "unresolved")
                        set(size32 0)
                        set(size64 0)
                        set(slots32 0)
                        set(slots64 0)
                    endif()
                    string(APPEND args_inc "WOW64_ARG(${call}, ${arg_index}, \"${arg_name}\", \"${arg_type}\", WOW64_ARG_${kind_upper}, ${size32}, ${size64}, ${slots32}, ${slots64})\n")
                endforeach()
            endif()
        endif()
        if(status STREQUAL "ok" OR status STREQUAL "by-value")
            math(EXPR summary_ok "${summary_ok} + 1")
        endif()
        string(APPEND calls_report "${call},${family},${id32},${id64},${count32},${count64},${model32},${model64},${argc},${byvalue},${cond},${class},${where},${status}\n")
        list(APPEND status_${status} "${call}")
    endforeach()
    set(wow64_calls_report "${calls_report}" PARENT_SCOPE)
    set(wow64_args_report "${args_report}" PARENT_SCOPE)
    set(wow64_args_inc "${args_inc}" PARENT_SCOPE)
    set(wow64_calls_total "${index}" PARENT_SCOPE)
    foreach(status ok by-value table-mismatch no-prototype unresolved ambiguous)
        list(LENGTH status_${status} status_count)
        set(wow64_count_${status} "${status_count}" PARENT_SCOPE)
        set(wow64_list_${status} "${status_${status}}" PARENT_SCOPE)
    endforeach()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    foreach(arg NT_SERVICES WIN32_SERVICES_32 WIN32_SERVICES_64 OUTPUT_DIR)
        if(NOT DEFINED ${arg})
            message(FATAL_ERROR "Missing -D${arg}=...")
        endif()
    endforeach()
    wow64_read_services("${NT_SERVICES}" nt TRUE FALSE)
    wow64_read_services("${WIN32_SERVICES_32}" w32 FALSE FALSE)
    wow64_read_services("${WIN32_SERVICES_64}" w64 FALSE TRUE)
    if(DEFINED PROTOTYPES)
        wow64_read_prototypes("${PROTOTYPES}")
    endif()
    if(DEFINED CATALOG)
        wow64_read_catalog()
    endif()
    wow64_map_services(nt nt nt32to64 0)
    wow64_map_services(nt nt nt64to32 0)
    wow64_map_services(w32 w64 win32k32to64 4096)
    wow64_map_services(w64 w32 win32k64to32 4096)
    if(STRICT AND (win32k32to64_problems OR win32k64to32_problems))
        message(FATAL_ERROR "Syscall mappings need explicit thunk review; see flagged entries above")
    endif()
    file(MAKE_DIRECTORY "${OUTPUT_DIR}")
    foreach(table nt32to64 nt64to32 win32k32to64 win32k64to32)
        file(WRITE "${OUTPUT_DIR}/${table}.inc" "${${table}_output}")
        file(WRITE "${OUTPUT_DIR}/${table}.csv" "${${table}_report}")
    endforeach()
    if(DEFINED PROTOTYPES)
        wow64_write_calls()
        file(WRITE "${OUTPUT_DIR}/calls.csv" "${wow64_calls_report}")
        file(WRITE "${OUTPUT_DIR}/args.csv" "${wow64_args_report}")
        file(WRITE "${OUTPUT_DIR}/args.inc" "${wow64_args_inc}")
        message(STATUS "prototypes: ${wow64_calls_total} calls, ${wow64_count_ok} match their prototype, "
            "${wow64_count_by-value} pass a structure by value, ${wow64_count_table-mismatch} disagree, "
            "${wow64_count_no-prototype} without prototype, ${wow64_count_unresolved} with an unknown argument type, "
            "${wow64_count_ambiguous} with several prototypes")
        wow64_check_tables()
        foreach(error IN LISTS wow64_table_errors)
            if(CHECK)
                message(SEND_ERROR "${error}")
            else()
                message(WARNING "${error}")
            endif()
        endforeach()
        if(CHECK AND wow64_table_errors)
            message(FATAL_ERROR "Syscall table slot counts disagree with the prototypes; see the errors above")
        endif()
    endif()
endif()
