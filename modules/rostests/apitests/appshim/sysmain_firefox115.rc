#include <windef.h>
#include <winuser.h>
#include <winver.h>

/* The version resource of Firefox 115.30.0 (firefox.exe), which the database entry for Firefox 4 to 115 matches */
1 VERSIONINFO
FILEVERSION 115,30,0,0
PRODUCTVERSION 115,30,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Mozilla Corporation"
            VALUE "FileDescription", "Firefox"
            VALUE "FileVersion", "115.30.0"
            VALUE "InternalName", "firefox"
            VALUE "OriginalFilename", "firefox.exe"
            VALUE "ProductName", "Firefox"
            VALUE "ProductVersion", "115.30.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

1 24 "sysmain_probe.manifest"
