softpipe: allocate the texture caches when a sampler view is first bound

softpipe_create_context allocated a texture tile cache for each of the
128 sampler view slots of each of the 6 shader stages, about 250 MB of
zeroed memory for every context. A 32-bit process has 2 GB of address
space, and a Direct3D program through wined3d creates several contexts,
so its persistent buffer allocation failed and it crashed. A cache now
exists only for a slot that was bound at least once.

diff -ru a/src/gallium/drivers/softpipe/sp_context.c b/src/gallium/drivers/softpipe/sp_context.c
--- a/src/gallium/drivers/softpipe/sp_context.c
+++ b/src/gallium/drivers/softpipe/sp_context.c
@@ -238,14 +238,8 @@
       softpipe->cbuf_cache[i] = sp_create_tile_cache( &softpipe->pipe );
    softpipe->zsbuf_cache = sp_create_tile_cache( &softpipe->pipe );
 
-   /* Allocate texture caches */
-   for (sh = 0; sh < ARRAY_SIZE(softpipe->tex_cache); sh++) {
-      for (i = 0; i < ARRAY_SIZE(softpipe->tex_cache[0]); i++) {
-         softpipe->tex_cache[sh][i] = sp_create_tex_tile_cache(&softpipe->pipe);
-         if (!softpipe->tex_cache[sh][i])
-            goto fail;
-      }
-   }
+   /* The texture caches are allocated when a sampler view is first bound to a slot:
+    * allocating all of them here takes about 250 MB per context. */
 
    softpipe->fs_machine = tgsi_exec_machine_create(MESA_SHADER_FRAGMENT);
 
