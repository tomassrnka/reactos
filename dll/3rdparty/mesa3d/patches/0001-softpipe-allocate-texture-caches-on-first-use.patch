-      sp_tex_tile_cache_set_sampler_view(softpipe->tex_cache[shader][start + i],
-                                         views[i]);
+      struct pipe_sampler_view *view = views[i];
+      struct softpipe_tex_tile_cache *tc = softpipe->tex_cache[shader][start + i];
